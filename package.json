{
  "name": "tortracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "supabase": {
      "tar": "7.5.22"
    }
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "node scripts/start-web.mjs",
    "typecheck": "tsc --noEmit",
    "local:setup": "node scripts/local-setup.mjs",
    "worker": "python -m worker.main",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.563.0",
    "maplibre-gl": "6.12.0",
    "next": "16.3.8",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "supabase": "2.76.0",
    "typescript": "^5.9.3"
  }
}
