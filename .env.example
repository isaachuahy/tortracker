NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable API key (sb_publishable_...). Safe for browser use.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret API key (sb_secret_...). Worker and local setup only.
# Never expose this key with NEXT_PUBLIC_. It grants elevated access and bypasses RLS.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-4.1-mini
EXTRACTION_API_URL=https://api.openai.com/v1/responses
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=120
# Set on the production web service. Password sign-in is for provisioned accounts.
APP_URL=http://localhost:3000
# Optional authorized JSON/CSV flyer feed, web service only.
# A literal {postal_code} is replaced with the signed-in user's saved area.
FLYER_FEED_URL=
FLYER_FEED_TOKEN=
FLYER_POSTAL_CODE=
# Optional read-only Gmail import service. Never put these in NEXT_PUBLIC_ variables.
# Set these on the separate email-import worker, not the web service.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_IMPORT_USER_ID=
GMAIL_EXPECTED_EMAIL=
GMAIL_IMPORT_PAGE_SIZE=25
GMAIL_IMPORT_INTERVAL_SECONDS=900
